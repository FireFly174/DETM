' BEGIN BLOCK: runtime/06_influence_merge_semantics.puml
' ============================================================
@startuml
autonumber
title Influence Merge Semantics (Deterministic, Not Commutative)

participant "TickScheduler" as TS
participant "TickRunner" as TR
participant "DetmSession" as S
participant "detm.runtime.api" as API

TS -> TR : due items (sorted by tick/order)
loop due influences
  TR -> TR : merged_overrides.update(dynamics_overrides)
end

note right of TR
Deterministic order: scheduler queue order.
If same key appears multiple times:
last write wins (order-sensitive).
=> Not commutative.
end note

TR -> S : step(override_influence, 1)
S -> S : policy decision + chunking

alt first chunk
  S -> API : step(state, full influence, chunk_n_ticks)
else subsequent chunks
  S -> API : step(state, override-only influence, chunk_n_ticks)
end

S -> S : merge chunk observables
note right of S
_merge_observables contract:
- events: concatenated in chunk order
- cost: summed by key
- signature/quality/field_summaries: last chunk
end note

@enduml

' END BLOCK: runtime/06_influence_merge_semantics.puml

' ============================================================
' BEGIN BLOCK: runtime/07_l0_tick_state_machine.puml
' ============================================================
@startuml
title L0 Tick Lifecycle State Machine (DetmSession)

[*] --> Idle
Idle --> Resetting : create()/reset()
Resetting --> Ready

Ready --> EvaluatingPolicy : step(influence, n_ticks)
EvaluatingPolicy --> DirectStep : effective_n_ticks <= 0
EvaluatingPolicy --> ChunkedStep : effective_n_ticks > 0

DirectStep --> Publishing : publish step event

state ChunkedStep {
  [*] --> ChunkStart
  ChunkStart --> CallAPI : api.step(chunk)
  CallAPI --> ChunkBoundaryPublish : boundary crossed
  CallAPI --> NextChunk : boundary not crossed
  ChunkBoundaryPublish --> NextChunk
  NextChunk --> ChunkStart : remaining > 0
  NextChunk --> [*] : remaining == 0
}

ChunkedStep --> Publishing : final merged observables
Publishing --> UpdateAdaptiveWindows
UpdateAdaptiveWindows --> Ready

Ready --> Closed : close()
Closed --> [*]

@enduml

' END BLOCK: runtime/07_l0_tick_state_machine.puml

' ============================================================
' BEGIN BLOCK: runtime/08_eventbus_sync_contract.puml
' ============================================================
@startuml
autonumber
title EventBus Sync Contract (Potential Blocking)

participant "Publisher\n(session/scheduler)" as Pub
participant "EventBus" as Bus
participant "Subscriber A" as A
participant "Subscriber B" as B
participant "Subscriber C" as C

Pub -> Bus : publish(event, payload)
Bus -> A : handler(payload)
A --> Bus : return
Bus -> B : handler(payload)
B --> Bus : return
Bus -> C : handler(payload)
C --> Bus : return
Bus --> Pub : publish() returns

note right of Bus
Synchronous and ordered by subscription.
Any slow handler blocks whole publish chain
(and can delay tick loop).
end note

@enduml

' END BLOCK: runtime/08_eventbus_sync_contract.puml

' ============================================================
' BEGIN BLOCK: runtime/09_runtime_adaptive_window_state_machine.puml
' ============================================================
@startuml
title Runtime Adaptive Window State Machine (LevelPolicy/DetmSession)

[*] --> Manual

state Manual {
  [*] --> Monitoring
}

Manual --> AdaptiveWindow : signal_triggered && step_after > cooldown_until\nset profile + adaptive_until + cooldown_until
AdaptiveWindow --> AdaptiveWindow : signal_triggered && step_after < adaptive_until\nextend adaptive_until (max)
AdaptiveWindow --> Cooldown : step_after >= adaptive_until
Cooldown --> Cooldown : signal_triggered && step_after <= cooldown_until\nignored (guard)
Cooldown --> Manual : step_after > cooldown_until

note right of Manual
Mode in policy_decision:
runtime_adaptive_profile = "manual"
end note

note right of AdaptiveWindow
Mode in policy_decision:
runtime_adaptive_profile = selected profile
runtime_adaptive_window_active = true
end note

note right of Cooldown
Window closed, re-entry blocked until cooldown expires.
end note

@enduml

' END BLOCK: runtime/09_runtime_adaptive_window_state_machine.puml

' ============================================================
' BEGIN BLOCK: runtime/10_runtime_adaptive_telemetry_sequence.puml
' ============================================================
@startuml
autonumber
title Runtime Adaptive Telemetry/Aggregation Sequence

participant "DetmSession.step" as Step
participant "policy_with_runtime_telemetry" as TelemetryFn
participant "LevelPolicy" as Policy
participant "_runtime_adaptive_telemetry_snapshot" as Snapshot
participant "runtime telemetry deque" as Deque

Step -> TelemetryFn : policy_with_runtime_telemetry(base_decision, observables)
TelemetryFn -> Policy : runtime_adaptive_signal_hits(events, quality, cost)
Policy --> TelemetryFn : signal_hits
TelemetryFn -> Policy : runtime_adaptive_signal_triggered(..., signal_hits)
Policy --> TelemetryFn : signal_triggered

TelemetryFn -> Snapshot : snapshot(tick, signal_triggered, signal_hits, profile, window_active)
Snapshot -> Policy : read sample_stride + aggregation_window
Policy --> Snapshot : thresholds

Snapshot -> Snapshot : include_hits = signal_triggered || tick % sample_stride == 0
Snapshot -> Deque : append current record
Snapshot -> Deque : trim to aggregation_window

loop aggregate over window
  Snapshot -> Snapshot : count triggered/window_active
  Snapshot -> Snapshot : count profile_counts
  Snapshot -> Snapshot : count signal_hit_counts
end

Snapshot --> TelemetryFn : sampled_hits, sampled_flag, aggregate
TelemetryFn --> Step : PolicyDecision with telemetry fields

note right of TelemetryFn
PolicyDecision extensions:
- runtime_adaptive_signal_triggered
- runtime_adaptive_signal_hits
- runtime_adaptive_signal_hits_sampled
- runtime_adaptive_aggregate
end note

@enduml

' END BLOCK: runtime/10_runtime_adaptive_telemetry_sequence.puml

